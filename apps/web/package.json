{
  "name": "sii-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check src tests *.ts *.js *.json index.html",
    "format": "prettier --write src tests *.ts *.js *.json index.html",
    "test": "vitest run",
    "e2e": "playwright test",
    "contracts": "openapi-typescript ../../packages/api-contracts/openapi.yaml -o ../../packages/api-contracts/schema.d.ts",
    "contracts:container": "openapi-typescript ../../packages/api-contracts/openapi.yaml -o /tmp/sii-schema.d.ts",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "openapi-fetch": "^0.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "17.13.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
